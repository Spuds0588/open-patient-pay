# ---------------------------------------------------------------------------
# Open Patient Pay — configuration template
# Copy to `.env` and adjust. See README.md for full documentation.
# ---------------------------------------------------------------------------

# --- Database ---
# Local development (host Postgres):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_patient_pay
# When running the app inside docker-compose, use the service name instead:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/open_patient_pay

# --- App ---
APP_NAME=My Clinic
APP_BASE_URL=http://localhost:3000

# --- Payments (Stripe) ---
# Leave STRIPE_SECRET_KEY empty to run in mock-payment mode (great for local
# demos). Set MOCK_PAYMENTS=true to force mock mode even when a key is present.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MOCK_PAYMENTS=true

# --- Open-core feature toggles ---
ENABLE_CLINIC_REGISTRATION=false
ENABLE_PATIENT_PORTAL=true
ENABLE_AUTO_DEBIT=true

# --- Installment plan limits (what patients are allowed to set up) ---
# Let patients define their own period (unit + interval + count) beyond presets.
PLAN_ALLOW_CUSTOM_PERIODS=true
# Let patients choose the date their first payment is processed.
PLAN_ALLOW_CUSTOM_DATE=true
# Minimum amount per payment, in cents ($10.00).
PLAN_MIN_PAYMENT_CENTS=1000
# Maximum number of payments in a plan.
PLAN_MAX_PAYMENTS=48
# Maximum total plan length, in months.
PLAN_MAX_MONTHS=60
# How far in the future the first payment may be scheduled (days).
PLAN_FIRST_PAYMENT_WINDOW_DAYS=60
# Comma-separated list of allowed period units: DAY,WEEK,MONTH
PLAN_ALLOWED_PERIOD_UNITS=DAY,WEEK,MONTH

# --- Optional admin API protection ---
# If set, /api/admin/* routes require `Authorization: Bearer <ADMIN_TOKEN>`.
ADMIN_TOKEN=

# --- docker-compose only ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_patient_pay
